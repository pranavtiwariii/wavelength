# ---------------------------------------------------------------------------
# Wavelength API - copy to server/.env and fill in as integrations land.
# Everything here has a working default, so `npm start` runs with no .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Leave DATABASE_URL unset to use PGlite (embedded Postgres, no install needed).
# Set it to a real Postgres connection string for staging/production.
# DATABASE_URL=postgres://user:pass@localhost:5432/wavelength
PGLITE_DIR=.pgdata

# Must be a real secret in production - the server refuses to boot otherwise.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=30d

# Echoes the OTP in the API response so the loop is testable with no SMS
# provider. MUST be false in production - it lets anyone sign in as anyone.
DEV_ECHO_OTP=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# --- Phase 1+ integrations (not needed yet) --------------------------------
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# TMDB_API_KEY=
# GOOGLE_BOOKS_API_KEY=
# ANTHROPIC_API_KEY=
